# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO - ACADEMIX
# ==============================================================================

# Entorno de Ejecución (En producción en la nube cambiar DEBUG a False)
DEBUG=True

# Clave Secreta de Django (Genere una clave única y aleatoria para producción)
SECRET_KEY=academix-super-secure-dev-key-change-in-production-2026!#sena

# Hosts permitidos:
# Para desarrollo/red local: *
# Para producción en la nube: dominio.com,academix.onrender.com
ALLOWED_HOSTS=*

# Orígenes confiables para CSRF (Requerido para login y formularios con HTTPS)
# Separe por comas las URLs completas (ej: https://academix.onrender.com,http://localhost:8000)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Base de Datos en la Nube (PostgreSQL / MySQL vía URL de conexión)
# DATABASE_URL=postgres://usuario:contraseña@servidor.com:5432/academix_db

# Base de Datos MySQL Local / Remota tradicional
# DB_ENGINE=mysql
# DB_NAME=academix_db
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Modo Fallback con SQLite (concurrencia optimizada con modo WAL para desarrollo y pruebas)
USE_SQLITE_FALLBACK=True

# Parámetros de Seguridad SSL (Por defecto activos automáticamente cuando DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
